{
  "name": "ledger-obsidian",
  "version": "0.3.3",
  "description": "Plain text accounting",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "pnpm run compile-parser && pnpm fix-parser && tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "fix-parser": "sed -i -e \"s/import moo from 'moo'/const moo = require('moo')/\" grammar/ledger.ts",
    "test": "pnpm run compile-parser && pnpm fix-parser && jest",
    "test-watch": "pnpm fix-parser && jest --watchAll",
    "prettier": "prettier --write 'src/**/*.+(ts|tsx|json|html|css)'",
    "eslint": "eslint . --ext .ts,.tsx --fix",
    "compile-parser": "nearleyc grammar/ledger.ne -o grammar/ledger.ts",
    "nearley-test": "nearley-test"
  },
  "keywords": [],
  "author": "Tony Grosinger",
  "license": "GPL-3.0",
  "devDependencies": {
    "@types/chartist": "0.11.1",
    "@types/jest": "30.0.0",
    "@types/lodash": "4.14.168",
    "@types/moo": "0.5.4",
    "@types/nearley": "2.11.1",
    "@types/node": "^14.18.63",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "@types/react-table": "7.7.20",
    "@types/styled-components": "5.1.36",
    "@typescript-eslint/eslint-plugin": "4.6.0",
    "@typescript-eslint/parser": "4.6.0",
    "esbuild": "0.25.5",
    "eslint": "7.12.1",
    "eslint-plugin-import": "2.22.1",
    "eslint-plugin-jsdoc": "30.7.3",
    "eslint-plugin-prefer-arrow": "1.2.2",
    "eslint-plugin-simple-import-sort": "5.0.3",
    "jest": "30.3.0",
    "jest-environment-jsdom": "30.3.0",
    "jest-mock-extended": "4.0.1",
    "moment": "2.29.1",
    "nearley": "2.20.1",
    "obsidian": "https://github.com/obsidianmd/obsidian-api/archive/5687a75ecfdb78b6a832127cf6f9229e27e196a0.tar.gz",
    "ts-jest": "29.4.9",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@popperjs/core": "2.11.8",
    "chartist": "0.11.4",
    "formik": "2.4.9",
    "fuse.js": "6.4.6",
    "intro.js": "4.3.0",
    "intro.js-react": "0.5.0",
    "lodash": "4.17.21",
    "monkey-around": "2.2.0",
    "moo": "0.5.1",
    "neverthrow": "3.0.0",
    "react": "^18.3.1",
    "react-chartist": "0.14.4",
    "react-dom": "^18.3.1",
    "react-popper": "^2.3.0",
    "react-table": "7.8.0",
    "styled-components": "^5.3.11",
    "tslib": "^2.8.1"
  },
  "pnpm": {
    "overrides": {
      "styled-components": "^5"
    },
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
